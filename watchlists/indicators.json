{
  "version": 1,
  "name": "Planetary indicators",
  "description": "Zero-key indicators the repo already ingests, watched against published thresholds: polar sea ice below the 1981–2010 p10, marine heatwaves (OISST), high river flow (GloFAS), city PM2.5 above the WHO guideline (CAMS), ENSO events (ONI), M7+ earthquakes (USGS), and new annual values of world indicators (Our World in Data). Points were checked live to sit on a big-river cell / an ocean cell.",
  "aois": [
    {
      "id": "seaice-arctic",
      "name": "Arctic sea ice",
      "bbox": [-180, 60, 180, 90],
      "tags": ["sea-ice", "polar"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "sea_ice", "hemisphere": "arctic" } }]
    },
    {
      "id": "seaice-antarctic",
      "name": "Antarctic sea ice",
      "bbox": [-180, -90, 180, -50],
      "tags": ["sea-ice", "polar"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "sea_ice", "hemisphere": "antarctic" } }]
    },
    {
      "id": "mhw-great-barrier-reef",
      "name": "Great Barrier Reef (central, Australia)",
      "bbox": [147.0, -19.0, 148.0, -18.0],
      "tags": ["ocean", "marine-heatwave"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "marine_heatwave", "lat": -18.5, "lon": 147.5, "minAnomalyC": 1.5, "minDays": 5 } }]
    },
    {
      "id": "mhw-florida-keys",
      "name": "Florida Keys reef tract (USA)",
      "bbox": [-81.5, 24.0, -80.5, 25.0],
      "tags": ["ocean", "marine-heatwave"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "marine_heatwave", "lat": 24.5, "lon": -81.0, "minAnomalyC": 1.5, "minDays": 5 } }]
    },
    {
      "id": "mhw-red-sea",
      "name": "Central Red Sea",
      "bbox": [37.5, 21.5, 38.5, 22.5],
      "tags": ["ocean", "marine-heatwave"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "marine_heatwave", "lat": 22.0, "lon": 38.0, "minAnomalyC": 1.5, "minDays": 5 } }]
    },
    {
      "id": "mhw-mediterranean",
