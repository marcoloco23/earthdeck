      "tags": ["ocean", "marine-heatwave"],
      "rules": [{ "name": "indicator_threshold", "params": { "indicator": "marine_heatwave", "lat": -38.0, "lon": 157.0, "minAnomalyC": 1.5, "minDays": 5 } }]
