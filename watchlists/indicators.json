      "id": "wp-living-planet",
      "name": "World: Living Planet Index",
      "bbox": [-180, -90, 180, 90],
      "tags": ["world-indicator"],
      "cooldownDays": 1,
      "notes": "One AOI per indicator: the kernel keys cases by rule + AOI, cooldownDays 1 lets each new year open its own case, and the rule never re-opens an indicator-year it already reported.",
      "rules": [{ "name": "indicator_trend", "params": { "indicator": "global-living-planet-index" } }]
